{
  "manifest_version": 3,
  "name": "PCS Meet Manager",
  "version": "1.0.0",
  "description": "Executive meeting manager, independent WebRTC video calls, calendar sync, and action item tracker with native Chrome Side Panel integration.",
  "action": {
    "default_title": "Open PCS Meet Manager Side Panel",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "sidePanel",
    "alarms",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
