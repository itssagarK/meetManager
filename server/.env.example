# Server Configuration
PORT=5000
NODE_ENV=development

# Optional Persistent Database Path (for cloud Docker / Render persistent disks)
# DATABASE_PATH=/data/meetings.db

# Optional WebRTC TURN Server Relay (for corporate VPNs / symmetric NATs)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_CREDENTIAL=pass

# Optional SMTP Email Configuration (for automated meeting invites & notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="PCS Meet Manager" <no-reply@pcsmeet.com>
