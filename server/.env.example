# Server Configuration
PORT=5000
NODE_ENV=development

# Public Base URL (Required for generating public guest join links & email invite links when tunneling or deployed)
# PUBLIC_URL=https://pcs-meetings.loca.lt
# Or when hosted: PUBLIC_URL=https://pcs-meetmanager.onrender.com

# Optional Persistent Database Path (for cloud Docker / Render persistent disks)
# DATABASE_PATH=/data/meetings.db

# Optional WebRTC TURN Server Relay (for corporate VPNs / symmetric NATs)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_CREDENTIAL=pass

# Optional SMTP Email Configuration (for automated meeting invites & notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="PCS Meet Manager" <no-reply@pcsmeet.com>

# Optional Cloudflare R2 / AWS S3 Object Storage & Media Offloading (Phase 2)
# If omitted, the server automatically defaults to high-speed local disk storage (/uploads)
# R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# R2_BUCKET=pcs-meet-assets
# R2_ACCESS_KEY_ID=<your-r2-access-key-id>
# R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
# R2_PUBLIC_URL=https://assets.yourcompany.com
#
# AWS S3 / MinIO Alternative:
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET=pcs-meet-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=<aws-access-key-id>
# S3_SECRET_ACCESS_KEY=<aws-secret-access-key>
# S3_PUBLIC_URL=https://pcs-meet-bucket.s3.amazonaws.com
