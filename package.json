{
  "name": "pcs-meet-manager",
  "version": "2.0.0",
  "private": true,
  "description": "PCS Meet Manager - Schedule meetings, track agendas, and organize action items.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/server.js",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "tunnel": "npx -y localtunnel --port 5000",
    "package:extension": "cd client && npm run package:extension"
  }
}
